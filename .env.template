COPILOTJ_DEV=1
COPILOTJ_LLM_MODEL=gpt-4.1-mini
COPILOTJ_LLM_API_KEY=sk-xxxxxxxx
COPILOTJ_LLM_PROXY=http://127.0.0.1:8080
COPILOTJ_LLM_BASE_URL=http://localhost:11434
# LLM provider (optional, auto-detected from model name if not set)
# Values: openai, openai-responses, anthropic, gemini, ollama, deepseek, siliconflow, openai-compatible
# COPILOTJ_LLM_PROVIDER=openai
COPILOTJ_VLM_MODEL=gemini-2.5-flash
COPILOTJ_VLM_API_KEY=sk-xxxxxxxx
# Enable vision features (set to 1 to enable). Disabled by default for privacy.
# When enabled, COPILOTJ_VLM_MODEL and COPILOTJ_VLM_API_KEY must be set.
# COPILOTJ_VISION_ENABLED=1
# COPILOTJ_VLM_PROXY=http://127.0.0.1:8080
COPILOTJ_VLM_BASE_URL=https://api.siliconflow.cn/v1
# VLM provider (optional, falls back to COPILOTJ_LLM_PROVIDER)
# COPILOTJ_VLM_PROVIDER=gemini
COPILOTJ_TAVILY_API_KEY=tvly-xxxxxxxxx
# Auto-ingest dialog summaries into knowledge bank (1 to enable, 0 to disable)
COPILOTJ_KB_AUTOSAVE=1
